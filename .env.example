# Application Server Configuration
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=9000

# Raft Node Configuration
RAFT_NODE1_PORT=50051
RAFT_NODE2_PORT=50052
RAFT_NODE3_PORT=50053

# LLM Server Configuration
LLM_SERVER_HOST=0.0.0.0
LLM_SERVER_PORT=8500
LLM_MODEL=Qwen/Qwen2.5-0.5B
LLM_MAX_NEW_TOKENS=512
LLM_TEMPERATURE=0.7

# Default Admin Credentials (Change in production!)
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=123

# Session Configuration
SESSION_TIMEOUT_HOURS=4

# Election Timeout (seconds)
RAFT_ELECTION_TIMEOUT_MIN=5
RAFT_ELECTION_TIMEOUT_MAX=8

# Heartbeat Interval (seconds)
RAFT_HEARTBEAT_INTERVAL=1

# Docker Environment
DOCKER_ENV=false

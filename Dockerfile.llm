# Dockerfile for LLM Server with Qwen2.5-0.5B
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies for PyTorch
RUN apt-get update && apt-get install -y \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first (for better Docker layer caching)
COPY requirements.txt .

# Install Python dependencies with extended timeout
RUN pip install --default-timeout=1000 --retries 5 --no-cache-dir -r requirements.txt

# Copy LLM code
COPY llm/ ./llm/

# Expose port
EXPOSE 8500

# Run the full LLM server with torch and transformers
CMD ["python", "-m", "uvicorn", "llm.llm_server:app", "--host", "0.0.0.0", "--port", "8500"]

# Optimized Dockerfile for LLM Server with Qwen2.5-0.5B
# Uses multi-stage build and pip cache for faster rebuilds
FROM python:3.10-slim as base

WORKDIR /app

# Install system dependencies for PyTorch (build stage)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy LLM requirements
COPY requirements-llm.txt .

# Install Python dependencies with cache mount for faster rebuilds
# Use pip cache to speed up repeated builds
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install --default-timeout=1000 -r requirements-llm.txt

# Copy LLM code
COPY llm/ ./llm/

# Expose port
EXPOSE 8500

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8500/health || exit 1

# Run the full LLM server with torch and transformers
CMD ["python", "-m", "uvicorn", "llm.llm_server:app", "--host", "0.0.0.0", "--port", "8500"]

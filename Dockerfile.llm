# Dockerfile for LLM Server
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .
# Increase pip timeout for large packages like torch (670MB)
RUN pip install --no-cache-dir --default-timeout=1000 --retries 5 -r requirements.txt

# Copy LLM code
COPY llm/ ./llm/

# Expose port
EXPOSE 8500

# Run the LLM server
CMD ["python", "-m", "uvicorn", "llm.llm_server:app", "--host", "0.0.0.0", "--port", "8500"]

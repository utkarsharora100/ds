# Optimized Dockerfile for Raft Nodes
# Minimal dependencies for consensus layer
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies (minimal)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy ONLY raft requirements (minimal dependencies)
COPY requirements-raft.txt .

# Install Python dependencies quickly
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-raft.txt

# Copy application code
COPY main.py .
COPY raft/ ./raft/
COPY proto/ ./proto/

# Raft nodes will use ports 50051-50053
EXPOSE 50051 50052 50053

# Entry point will be overridden in docker-compose with node ID
ENTRYPOINT ["python", "main.py"]
